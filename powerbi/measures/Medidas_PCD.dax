// ============================================================
// PCD Workforce & Inclusion — Medidas DAX (lista completa do cliente)
// HC Total: cliente pode substituir por valor fixo depois, se necessário.
// ============================================================

// --- Headcount ---
HC Total = 
CALCULATE ( COUNTROWS ( COLABORADORES ), COLABORADORES[Status] = "Ativo" )
// Alternativa (número exato fixo): HC Total = 1234

HC PCD = 
CALCULATE ( COUNTROWS ( COLABORADORES ), COLABORADORES[Status] = "Ativo", COLABORADORES[PCD] = "Sim" )

HC Nao PCD = 
CALCULATE ( COUNTROWS ( COLABORADORES ), COLABORADORES[Status] = "Ativo", COLABORADORES[PCD] = "Não" )

Pct PCD = DIVIDE ( [HC PCD], [HC Total] )

Meta Pct PCD = AVERAGE ( METAS[Meta % PCD] )

GAP PP = [Pct PCD] - [Meta Pct PCD]

GAP Qtd PCD = ( [Meta Pct PCD] * [HC Total] ) - [HC PCD]
// >0 = faltam PCD para a meta; <0 = excedente

// --- Movimentações ---
Admissoes PCD = 
CALCULATE (
    COUNTROWS ( 'MOVIMENTAÇÕES' ),
    'MOVIMENTAÇÕES'[Tipo Movimento] = "Admissão",
    'MOVIMENTAÇÕES'[PCD] = "Sim"
)

Desligamentos PCD = 
CALCULATE (
    COUNTROWS ( 'MOVIMENTAÇÕES' ),
    'MOVIMENTAÇÕES'[Tipo Movimento] = "Desligamento",
    'MOVIMENTAÇÕES'[PCD] = "Sim"
)

Promocoes PCD = 
CALCULATE (
    COUNTROWS ( 'MOVIMENTAÇÕES' ),
    'MOVIMENTAÇÕES'[Tipo Movimento] = "Promoção",
    'MOVIMENTAÇÕES'[PCD] = "Sim"
)

Movimentacoes Internas PCD = 
CALCULATE (
    COUNTROWS ( 'MOVIMENTAÇÕES' ),
    'MOVIMENTAÇÕES'[Tipo Movimento] = "Movimentação Interna",
    'MOVIMENTAÇÕES'[PCD] = "Sim"
)

Desligamentos Gerais = 
CALCULATE (
    COUNTROWS ( 'MOVIMENTAÇÕES' ),
    'MOVIMENTAÇÕES'[Tipo Movimento] = "Desligamento"
)

Turnover PCD = DIVIDE ( [Desligamentos PCD], [HC PCD] )

Turnover Geral = DIVIDE ( [Desligamentos Gerais], [HC Total] )

// --- Tempo de empresa (usar coluna calculada Faixa Tempo ou visual por buckets) ---
// Coluna calculada sugerida em COLABORADORES:
// Faixa Tempo Empresa =
// VAR Anos = DIVIDE ( DATEDIFF ( [Data de Admissão], TODAY(), DAY ), 365.25 )
// RETURN SWITCH ( TRUE(),
//     Anos < 1, "<1 ano",
//     Anos < 3, "1–3 anos",
//     Anos < 5, "3–5 anos",
//     ">5 anos" )

Tempo Medio Empresa PCD Anos = 
AVERAGEX (
    FILTER ( COLABORADORES, COLABORADORES[Status] = "Ativo" && COLABORADORES[PCD] = "Sim" ),
    DIVIDE ( DATEDIFF ( COLABORADORES[Data de Admissão], TODAY (), DAY ), 365.25 )
)

// --- Classificação & liderança ---
HC Blue Collar = CALCULATE ( [HC Total], COLABORADORES[Classificação] = "Blue Collar" )
HC White Collar = CALCULATE ( [HC Total], COLABORADORES[Classificação] = "White Collar" )
HC PCD Blue Collar = CALCULATE ( [HC PCD], COLABORADORES[Classificação] = "Blue Collar" )
HC PCD White Collar = CALCULATE ( [HC PCD], COLABORADORES[Classificação] = "White Collar" )
Pct PCD Blue Collar = DIVIDE ( [HC PCD Blue Collar], [HC Blue Collar] )
Pct PCD White Collar = DIVIDE ( [HC PCD White Collar], [HC White Collar] )

HC PCD Lideranca = CALCULATE ( [HC PCD], COLABORADORES[Liderança] = "Sim" )
Pct PCD sobre PCD em Lideranca = DIVIDE ( [HC PCD Lideranca], [HC PCD] )
HC Lideranca Total = CALCULATE ( [HC Total], COLABORADORES[Liderança] = "Sim" )
Pct PCD em posicoes de Lideranca = DIVIDE ( [HC PCD Lideranca], [HC Lideranca Total] )

// --- Histórico ---
HC Total Historico = SUM ( 'HISTÓRICO MENSAL'[HC Total] )
HC PCD Historico = SUM ( 'HISTÓRICO MENSAL'[HC PCD] )
Pct PCD Historico = DIVIDE ( [HC PCD Historico], [HC Total Historico] )
GAP Historico = [Pct PCD Historico] - [Meta Pct PCD]

Qtd Areas = DISTINCTCOUNT ( COLABORADORES[Área] )
