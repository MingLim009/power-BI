// DimCalendario — cola como New table (DAX) no Power BI
// Marcar a coluna [Date] como Date table

DimCalendario =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Ano", YEAR ( [Date] ),
    "Mês", MONTH ( [Date] ),
    "Nome Mês", FORMAT ( [Date], "MMM" ),
    "AnoMês", FORMAT ( [Date], "YYYY-MM" ),
    "AnoMês Ordenacao", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
    "Trimestre", "T" & FORMAT ( [Date], "Q" ),
    "Início Mês", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
)

// DimArea — 9 áreas oficiais FIXAS (sempre aparecem, mesmo com HC = 0)
// Usar DimArea[Área] em slicers, eixos e tabela "Resumo por Área"
DimArea =
DATATABLE (
    "Área", STRING,
    "Ordem", INTEGER,
    {
        { "Montagem", 1 },
        { "Qualidade", 2 },
        { "Pintura", 3 },
        { "Logística", 4 },
        { "Funilaria", 5 },
        { "Supply Chain", 6 },
        { "Prensa", 7 },
        { "General Service", 8 },
        { "Staff e Outras", 9 }
    }
)
// Relacionar DimArea[Área] 1:* com COLABORADORES[Área],
// HISTÓRICO MENSAL[Oficina], METAS[Oficina], MOVIMENTAÇÕES[Oficina]
// (Oficina = Área oficial neste projeto)

DimPlanta =
DISTINCT (
    UNION (
        SELECTCOLUMNS ( COLABORADORES, "Planta", COLABORADORES[Planta] ),
        SELECTCOLUMNS ( 'HISTÓRICO MENSAL', "Planta", 'HISTÓRICO MENSAL'[Planta] ),
        SELECTCOLUMNS ( METAS, "Planta", METAS[Planta] )
    )
)
